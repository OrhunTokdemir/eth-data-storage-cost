# Copy to .env and fill in. NEVER commit .env.
# Local Anvil RPC (default)
RPC_URL=http://127.0.0.1:8545
# Anvil default dev key #0 (public, test-only; never use with real funds)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Path to the proof to store/benchmark (or random:<bytes>)
PROOF_PATH=proofs/proof.bin
# Etherscan API key for live gas prices (https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=your-etherscan-api-key-here
# Optional: Sepolia RPC used as fallback for live Sepolia gas price
SEPOLIA_RPC_URL=
